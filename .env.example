# PostgreSQL Settings
POSTGRES_DB=tinder_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword

# Redis Settings
REDIS_PORT=6379

# MinIO (S3 Storage) Settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Cloudinary (optional)
CLOUDINARY_URL=

# Django (prod: DEBUG=0)
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,crush.pp.ua,10.239.88.223
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://crush.pp.ua,https://10.239.88.223
USE_X_FORWARDED_HOST=1
# Прод: обов'язково. Google забороняє redirect_uri на приватний IP (10.x).
# Має збігатися з Google Console + Sites в Django admin (не chartpp.ua).
# Локально через localhost: залиште порожнім (PUBLIC_HOST=).
PUBLIC_HOST=crush.pp.ua
